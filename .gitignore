# Derived run reports — regenerated by their own script on every --write pass.
# Never a source of truth: read the committed assets/data.js instead.
engine/rollforward_ledger.json
engine/technicals_report.json

# Bytecode. NOTE: engine/__pycache__/*.cpython-312.pyc are already TRACKED from
# before this file existed — .gitignore does not untrack them, and untracking is
# a separate decision. This rule only stops newly-generated bytecode (a different
# interpreter minor version produces differently-named files) from showing up as
# untracked noise on every run.
__pycache__/
*.pyc

# scripts/check_ta_chart_overlay.js — the MANDATORY overlay gate — needs playwright,
# and there is no package.json, so running it means `npm install --no-save playwright`
# in the repo root. That leaves ~100MB of untracked noise in `git status` on every
# pass that honours the gate. The browser binary itself is pre-provisioned at
# /opt/pw-browsers/chromium (the script hardcodes that executablePath), so only the
# node package is ever fetched.
node_modules/

# Phase C point-in-time fair-value cache (derived from git history; self-invalidating)
engine/.pit_fair_values_*.json
engine/.pit_tmp_data.js
